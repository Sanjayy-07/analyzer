# Copy this file to .env (or export these as real environment variables)
# before running the webapp. Never commit a real .env file.

# --- Database (Part 25/39) ---
DB_URL=jdbc:mysql://localhost:3306/archanalyzer
DB_USERNAME=root
DB_PASSWORD=changeme

# --- Generative AI / LLM Gateway Configuration ---
# Configurable providers: "gemini", "openai", "anthropic", "ollama", or "disabled"
LLM_PROVIDER=gemini
# Provider API key (placeholders like 'replace-with-your-api-key' automatically keep AI in standby)
LLM_API_KEY=replace-with-your-api-key
# Custom Base URL (optional, e.g. http://localhost:11434 for Ollama, https://api.openai.com for OpenAI)
LLM_API_BASE_URL=
# Model name (e.g., gemini-3.5-flash, gpt-4o-mini, claude-3-5-sonnet-20241022, llama3)
LLM_MODEL=gemini-3.5-flash
# Timeout in seconds
LLM_TIMEOUT_SECONDS=90

# --- Session / security ---
SESSION_SECRET=replace-with-a-random-64-char-string
